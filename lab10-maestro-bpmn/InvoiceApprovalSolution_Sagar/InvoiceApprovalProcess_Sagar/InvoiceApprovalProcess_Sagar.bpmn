<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:uipath="http://uipath.org/schema/bpmn" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="UiPath Maestro (https://uipath.com)" exporterVersion="1.202.3">
  <bpmn:process id="Process_1" name="InvoiceApprovalProcess_Sagar" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:variables version="v1">
        <uipath:input id="VarFileName" name="FileName" type="string" elementId="Event_start" />
        <uipath:inputOutput id="VarRecordId" name="RecordId" type="string" />
        <uipath:inputOutput id="VarIsValid" name="IsValid" type="boolean" />
        <uipath:inputOutput id="VarWasDuplicate" name="WasDuplicate" type="boolean" />
        <uipath:inputOutput id="VarPOMatched" name="POMatched" type="boolean" />
        <uipath:inputOutput id="VarApprovalNeeded" name="ApprovalNeeded" type="boolean" />
        <uipath:inputOutput id="VarMatchReason" name="MatchReason" type="string" />
        <uipath:inputOutput id="VarPoErrorType" name="PoErrorType" type="string" />
        <uipath:inputOutput id="VarRecommendation" name="Recommendation" type="string" />
        <uipath:inputOutput id="VarWasAlreadyPrepared" name="WasAlreadyPrepared" type="boolean" />
        <uipath:inputOutput id="VarAgentErrorType" name="AgentErrorType" type="string" />
        <uipath:inputOutput id="VarInvoiceLifecycleState" name="InvoiceLifecycleState" type="string" />
        <uipath:inputOutput id="VarPostedToERP" name="PostedToERP" type="boolean" />
        <uipath:inputOutput id="VarStatusFound" name="StatusFound" type="boolean" />
        <uipath:inputOutput id="VarStatusErrorType" name="StatusErrorType" type="string" />
        <uipath:inputOutput id="VarReviewedBy" name="ReviewedBy" type="string" />
        <uipath:inputOutput id="VarApprovalConfirmed" name="ApprovalConfirmed" type="boolean" />
        <uipath:inputOutput id="VarPollCount" name="PollCount" type="number" />
        <uipath:inputOutput id="VarPosted" name="Posted" type="boolean" />
        <uipath:inputOutput id="VarWasAlreadyPosted" name="WasAlreadyPosted" type="boolean" />
        <uipath:inputOutput id="VarPostingId" name="PostingId" type="string" />
        <uipath:inputOutput id="VarErrorMessage" name="ErrorMessage" type="string" />
        <uipath:inputOutput id="VarTaskIntakeResponse" name="TaskIntakeResponse" type="any" />
        <uipath:inputOutput id="VarTaskPOMatchResponse" name="TaskPOMatchResponse" type="any" />
        <uipath:inputOutput id="VarTaskAgentResponse" name="TaskAgentResponse" type="any" />
        <uipath:inputOutput id="VarTaskStatusResponse" name="TaskStatusResponse" type="any" />
        <uipath:inputOutput id="VarTaskPostResponse" name="TaskPostResponse" type="any" />
      </uipath:variables>
      <uipath:bindings version="v1">
        <uipath:binding id="bIntakeName" name="name" type="string" default="Invoice_Intake_RPA_Sagar" resource="process" resourceSubType="Process" resourceKey="Agentic Bootcamp/APAutomation_Sagar.Invoice_Intake_RPA_Sagar" propertyAttribute="name" />
        <uipath:binding id="bIntakeFolder" name="folderPath" type="string" default="Agentic Bootcamp/APAutomation_Sagar" resource="process" resourceSubType="Process" resourceKey="Agentic Bootcamp/APAutomation_Sagar.Invoice_Intake_RPA_Sagar" propertyAttribute="folderPath" />
        <uipath:binding id="bPOMatchName" name="name" type="string" default="POMatch_Sagar_process_invoice" resource="process" resourceSubType="Function" resourceKey="Agentic Bootcamp/APAutomation_Sagar.POMatch_Sagar_process_invoice" propertyAttribute="name" />
        <uipath:binding id="bPOMatchFolder" name="folderPath" type="string" default="Agentic Bootcamp/APAutomation_Sagar" resource="process" resourceSubType="Function" resourceKey="Agentic Bootcamp/APAutomation_Sagar.POMatch_Sagar_process_invoice" propertyAttribute="folderPath" />
        <uipath:binding id="bAgentName" name="name" type="string" default="Invoice_Approval_Agent_Sagar" resource="process" resourceSubType="Agent" resourceKey="Agentic Bootcamp/APAutomation_Sagar.Invoice_Approval_Agent_Sagar" propertyAttribute="name" />
        <uipath:binding id="bAgentFolder" name="folderPath" type="string" default="Agentic Bootcamp/APAutomation_Sagar" resource="process" resourceSubType="Agent" resourceKey="Agentic Bootcamp/APAutomation_Sagar.Invoice_Approval_Agent_Sagar" propertyAttribute="folderPath" />
        <uipath:binding id="bStatusName" name="name" type="string" default="POMatch_Sagar_get_invoice_status" resource="process" resourceSubType="Function" resourceKey="Agentic Bootcamp/APAutomation_Sagar.POMatch_Sagar_get_invoice_status" propertyAttribute="name" />
        <uipath:binding id="bStatusFolder" name="folderPath" type="string" default="Agentic Bootcamp/APAutomation_Sagar" resource="process" resourceSubType="Function" resourceKey="Agentic Bootcamp/APAutomation_Sagar.POMatch_Sagar_get_invoice_status" propertyAttribute="folderPath" />
        <uipath:binding id="bPostName" name="name" type="string" default="PostToERP_Sagar" resource="process" resourceSubType="Process" resourceKey="Agentic Bootcamp/APAutomation_Sagar.PostToERP_Sagar" propertyAttribute="name" />
        <uipath:binding id="bPostFolder" name="folderPath" type="string" default="Agentic Bootcamp/APAutomation_Sagar" resource="process" resourceSubType="Process" resourceKey="Agentic Bootcamp/APAutomation_Sagar.PostToERP_Sagar" propertyAttribute="folderPath" />
      </uipath:bindings>
    </bpmn:extensionElements>
    <bpmn:startEvent id="Event_start" name="Manual start">
      <bpmn:extensionElements>
        <uipath:entryPointId value="f027217e-642e-4ef7-b83d-069ba0464c95" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_Start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Intake" name="Intake invoice (Invoice_Intake_RPA_Sagar)">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.StartJob" version="v1" />
          <uipath:context>
            <uipath:input name="releaseKey" type="string" value="EAFF5F99-12F3-4FE9-8413-F8B782033426" />
            <uipath:input name="folderId" type="string" value="1248669" />
            <uipath:input name="folderPath" type="string" value="=bindings.bIntakeFolder" />
            <uipath:input name="name" type="string" value="=bindings.bIntakeName" />
            <uipath:inputSchema type="jsonSchema"><![CDATA[{"type":"object","properties":{"FileName":{"type":"string"},"CreateQueueItem":{"type":"boolean"}},"required":[]}]]></uipath:inputSchema>
          </uipath:context>
          <uipath:input name="JobArguments" type="json" target="bodyField"><![CDATA[{"FileName":"=vars.VarFileName","CreateQueueItem":false}]]></uipath:input>
          <uipath:output name="Process response" type="Orchestrator.RunJob" var="VarTaskIntakeResponse" />
          <uipath:output name="RecordId" type="string" source="=RecordId" var="VarRecordId" />
          <uipath:output name="IsValid" type="boolean" source="=IsValid" var="VarIsValid" />
          <uipath:output name="WasDuplicate" type="boolean" source="=WasDuplicate" var="VarWasDuplicate" />
          <uipath:output name="ErrorMessage" type="string" source="=ErrorMessage" var="VarErrorMessage" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start</bpmn:incoming>
      <bpmn:outgoing>Flow_Intake_Done</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Valid" name="Valid?" default="Flow_Valid_No">
      <bpmn:incoming>Flow_Intake_Done</bpmn:incoming>
      <bpmn:outgoing>Flow_Valid_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Valid_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Invalid" name="Invalid Invoice">
      <bpmn:incoming>Flow_Valid_No</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_POMatch" name="PO match (POMatch_Sagar process_invoice)">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.StartJob" version="v1" />
          <uipath:context>
            <uipath:input name="releaseKey" type="string" value="C085A427-F102-4CD4-8E52-DE465205A366" />
            <uipath:input name="folderId" type="string" value="1248669" />
            <uipath:input name="folderPath" type="string" value="=bindings.bPOMatchFolder" />
            <uipath:input name="name" type="string" value="=bindings.bPOMatchName" />
            <uipath:inputSchema type="jsonSchema"><![CDATA[{"type":"object","properties":{"record_id":{"type":"string"},"entity_name":{"type":"string"}},"required":[]}]]></uipath:inputSchema>
          </uipath:context>
          <uipath:input name="JobArguments" type="json" target="bodyField"><![CDATA[{"record_id":"=vars.VarRecordId"}]]></uipath:input>
          <uipath:output name="Process response" type="Orchestrator.RunJob" var="VarTaskPOMatchResponse" />
          <uipath:output name="po_matched" type="boolean" source="=po_matched" var="VarPOMatched" />
          <uipath:output name="approval_required" type="boolean" source="=approval_required" var="VarApprovalNeeded" />
          <uipath:output name="match_reason" type="string" source="=match_reason" var="VarMatchReason" />
          <uipath:output name="error_type" type="string" source="=error_type" var="VarPoErrorType" />
          <uipath:output name="error_message" type="string" source="=error_message" var="VarErrorMessage" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Valid_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_PO_Done</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_ApprovalNeeded" name="Approval needed?" default="Flow_Appr_No">
      <bpmn:incoming>Flow_PO_Done</bpmn:incoming>
      <bpmn:outgoing>Flow_PO_Error</bpmn:outgoing>
      <bpmn:outgoing>Flow_Appr_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Appr_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Script_NoApproval" name="Set ApprovalConfirmed false" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.Variables" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{}]]></uipath:input>
          <uipath:output name="ApprovalConfirmed" type="boolean" source="=js:false" var="VarApprovalConfirmed" custom="true" />
        </uipath:mapping>
        <uipath:scriptVersion value="v3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Appr_No</bpmn:incoming>
      <bpmn:outgoing>Flow_NoAppr_Post</bpmn:outgoing>
      <bpmn:script><![CDATA[return {};]]></bpmn:script>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="Task_Agent" name="Prepare approval (Invoice_Approval_Agent_Sagar)">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.StartJob" version="v1" />
          <uipath:context>
            <uipath:input name="releaseKey" type="string" value="2CB7C282-4FE3-4B25-B1AA-D29AA944FE66" />
            <uipath:input name="folderId" type="string" value="1248669" />
            <uipath:input name="folderPath" type="string" value="=bindings.bAgentFolder" />
            <uipath:input name="name" type="string" value="=bindings.bAgentName" />
            <uipath:inputSchema type="jsonSchema"><![CDATA[{"type":"object","properties":{"recordId":{"type":"string"}},"required":["recordId"]}]]></uipath:inputSchema>
          </uipath:context>
          <uipath:input name="JobArguments" type="json" target="bodyField"><![CDATA[{"recordId":"=vars.VarRecordId"}]]></uipath:input>
          <uipath:output name="Process response" type="Orchestrator.RunJob" var="VarTaskAgentResponse" />
          <uipath:output name="recommendation" type="string" source="=recommendation" var="VarRecommendation" />
          <uipath:output name="invoiceLifecycleState" type="string" source="=invoiceLifecycleState" var="VarInvoiceLifecycleState" />
          <uipath:output name="wasAlreadyPrepared" type="boolean" source="=wasAlreadyPrepared" var="VarWasAlreadyPrepared" />
          <uipath:output name="errorType" type="string" source="=errorType" var="VarAgentErrorType" />
          <uipath:output name="errorMessage" type="string" source="=errorMessage" var="VarErrorMessage" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Appr_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Agent_Done</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_AgentResult" name="Held?" default="Flow_Agent_Review">
      <bpmn:incoming>Flow_Agent_Done</bpmn:incoming>
      <bpmn:outgoing>Flow_Agent_Held</bpmn:outgoing>
      <bpmn:outgoing>Flow_Agent_Review</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Held" name="Held">
      <bpmn:incoming>Flow_Agent_Held</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gw_WaitJoin" name="Await review">
      <bpmn:incoming>Flow_Agent_Review</bpmn:incoming>
      <bpmn:incoming>Flow_Loop</bpmn:incoming>
      <bpmn:outgoing>Flow_Wait_Timer</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Timer_Wait" name="Wait 2 minutes">
      <bpmn:incoming>Flow_Wait_Timer</bpmn:incoming>
      <bpmn:outgoing>Flow_Timer_Count</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT2M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:scriptTask id="Script_CountPoll" name="PollCount + 1" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.Variables" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{}]]></uipath:input>
          <uipath:output name="PollCount" type="number" source="=js:(vars.VarPollCount || 0) + 1" var="VarPollCount" custom="true" />
        </uipath:mapping>
        <uipath:scriptVersion value="v3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Timer_Count</bpmn:incoming>
      <bpmn:outgoing>Flow_Count_Status</bpmn:outgoing>
      <bpmn:script><![CDATA[return {};]]></bpmn:script>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="Task_Status" name="Read status (POMatch_Sagar get_invoice_status)">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.StartJob" version="v1" />
          <uipath:context>
            <uipath:input name="releaseKey" type="string" value="2D7A6464-8C16-4859-8F78-75104005F1AF" />
            <uipath:input name="folderId" type="string" value="1248669" />
            <uipath:input name="folderPath" type="string" value="=bindings.bStatusFolder" />
            <uipath:input name="name" type="string" value="=bindings.bStatusName" />
            <uipath:inputSchema type="jsonSchema"><![CDATA[{"type":"object","properties":{"record_id":{"type":"string"},"entity_name":{"type":"string"}},"required":[]}]]></uipath:inputSchema>
          </uipath:context>
          <uipath:input name="JobArguments" type="json" target="bodyField"><![CDATA[{"record_id":"=vars.VarRecordId"}]]></uipath:input>
          <uipath:output name="Process response" type="Orchestrator.RunJob" var="VarTaskStatusResponse" />
          <uipath:output name="invoice_lifecycle_state" type="string" source="=invoice_lifecycle_state" var="VarInvoiceLifecycleState" />
          <uipath:output name="approval_needed" type="boolean" source="=approval_needed" var="VarApprovalNeeded" />
          <uipath:output name="posted_to_erp" type="boolean" source="=posted_to_erp" var="VarPostedToERP" />
          <uipath:output name="reviewed_by" type="string" source="=reviewed_by" var="VarReviewedBy" />
          <uipath:output name="found" type="boolean" source="=found" var="VarStatusFound" />
          <uipath:output name="error_type" type="string" source="=error_type" var="VarStatusErrorType" />
          <uipath:output name="error_message" type="string" source="=error_message" var="VarErrorMessage" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Count_Status</bpmn:incoming>
      <bpmn:outgoing>Flow_Status_Done</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Approved" name="Approved?" default="Flow_Appr_Unexpected">
      <bpmn:incoming>Flow_Status_Done</bpmn:incoming>
      <bpmn:outgoing>Flow_Status_Error</bpmn:outgoing>
      <bpmn:outgoing>Flow_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_Rejected</bpmn:outgoing>
      <bpmn:outgoing>Flow_Loop</bpmn:outgoing>
      <bpmn:outgoing>Flow_PollCap</bpmn:outgoing>
      <bpmn:outgoing>Flow_Appr_Unexpected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Rejected" name="Rejected">
      <bpmn:incoming>Flow_Rejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_HeldNoDecision" name="Held">
      <bpmn:incoming>Flow_PollCap</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:scriptTask id="Script_Approved" name="Set ApprovalConfirmed true" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.Variables" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{}]]></uipath:input>
          <uipath:output name="ApprovalConfirmed" type="boolean" source="=js:true" var="VarApprovalConfirmed" custom="true" />
        </uipath:mapping>
        <uipath:scriptVersion value="v3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_Approved_Post</bpmn:outgoing>
      <bpmn:script><![CDATA[return {};]]></bpmn:script>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Gw_PostJoin" name="Ready to post">
      <bpmn:incoming>Flow_NoAppr_Post</bpmn:incoming>
      <bpmn:incoming>Flow_Approved_Post</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Post</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Post" name="Post to ERP (PostToERP_Sagar)">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.StartJob" version="v1" />
          <uipath:context>
            <uipath:input name="releaseKey" type="string" value="CE50297F-925F-40D6-8D07-E879A76A0EAA" />
            <uipath:input name="folderId" type="string" value="1248669" />
            <uipath:input name="folderPath" type="string" value="=bindings.bPostFolder" />
            <uipath:input name="name" type="string" value="=bindings.bPostName" />
            <uipath:inputSchema type="jsonSchema"><![CDATA[{"type":"object","properties":{"RecordId":{"type":"string"},"ApprovalConfirmed":{"type":"boolean"},"PortalUrl":{"type":"string"}},"required":[]}]]></uipath:inputSchema>
          </uipath:context>
          <uipath:input name="JobArguments" type="json" target="bodyField"><![CDATA[{"RecordId":"=vars.VarRecordId","ApprovalConfirmed":"=vars.VarApprovalConfirmed","PortalUrl":"https://commercial-bootcamp-mock-erp.onrender.com/portal/"}]]></uipath:input>
          <uipath:output name="Process response" type="Orchestrator.RunJob" var="VarTaskPostResponse" />
          <uipath:output name="Posted" type="boolean" source="=Posted" var="VarPosted" />
          <uipath:output name="WasAlreadyPosted" type="boolean" source="=WasAlreadyPosted" var="VarWasAlreadyPosted" />
          <uipath:output name="PostingId" type="string" source="=PostingId" var="VarPostingId" />
          <uipath:output name="ErrorMessage" type="string" source="=ErrorMessage" var="VarErrorMessage" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Join_Post</bpmn:incoming>
      <bpmn:outgoing>Flow_Post_Done</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Posted" name="Posted?" default="Flow_Posted_No">
      <bpmn:incoming>Flow_Post_Done</bpmn:incoming>
      <bpmn:outgoing>Flow_Posted_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Posted_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Paid" name="Paid">
      <bpmn:incoming>Flow_Posted_Yes</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gw_FailJoin" name="Failure">
      <bpmn:incoming>Flow_PO_Error</bpmn:incoming>
      <bpmn:incoming>Flow_Status_Error</bpmn:incoming>
      <bpmn:incoming>Flow_Appr_Unexpected</bpmn:incoming>
      <bpmn:incoming>Flow_Posted_No</bpmn:incoming>
      <bpmn:incoming>Flow_Err_Task_Intake</bpmn:incoming>
      <bpmn:incoming>Flow_Err_Task_POMatch</bpmn:incoming>
      <bpmn:incoming>Flow_Err_Task_Agent</bpmn:incoming>
      <bpmn:incoming>Flow_Err_Task_Status</bpmn:incoming>
      <bpmn:incoming>Flow_Err_Task_Post</bpmn:incoming>
      <bpmn:outgoing>Flow_Fail_End</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_OpFailure" name="Operational Failure">
      <bpmn:incoming>Flow_Fail_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="Err_Task_Intake" name="Job failed" attachedToRef="Task_Intake" cancelActivity="true">
      <bpmn:outgoing>Flow_Err_Task_Intake</bpmn:outgoing>
      <bpmn:errorEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Err_Task_POMatch" name="Job failed" attachedToRef="Task_POMatch" cancelActivity="true">
      <bpmn:outgoing>Flow_Err_Task_POMatch</bpmn:outgoing>
      <bpmn:errorEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Err_Task_Agent" name="Job failed" attachedToRef="Task_Agent" cancelActivity="true">
      <bpmn:outgoing>Flow_Err_Task_Agent</bpmn:outgoing>
      <bpmn:errorEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Err_Task_Status" name="Job failed" attachedToRef="Task_Status" cancelActivity="true">
      <bpmn:outgoing>Flow_Err_Task_Status</bpmn:outgoing>
      <bpmn:errorEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Err_Task_Post" name="Job failed" attachedToRef="Task_Post" cancelActivity="true">
      <bpmn:outgoing>Flow_Err_Task_Post</bpmn:outgoing>
      <bpmn:errorEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_Start" sourceRef="Event_start" targetRef="Task_Intake" />
    <bpmn:sequenceFlow id="Flow_Intake_Done" sourceRef="Task_Intake" targetRef="Gw_Valid" />
    <bpmn:sequenceFlow id="Flow_Valid_Yes" name="Yes" sourceRef="Gw_Valid" targetRef="Task_POMatch">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=vars.VarIsValid == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Valid_No" name="No" sourceRef="Gw_Valid" targetRef="End_Invalid" />
    <bpmn:sequenceFlow id="Flow_PO_Done" sourceRef="Task_POMatch" targetRef="Gw_ApprovalNeeded" />
    <bpmn:sequenceFlow id="Flow_PO_Error" name="PO error" sourceRef="Gw_ApprovalNeeded" targetRef="Gw_FailJoin">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=vars.VarPoErrorType != null &amp;&amp; vars.VarPoErrorType != ""</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Appr_Yes" name="Yes" sourceRef="Gw_ApprovalNeeded" targetRef="Task_Agent">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=vars.VarApprovalNeeded == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Appr_No" name="No" sourceRef="Gw_ApprovalNeeded" targetRef="Script_NoApproval" />
    <bpmn:sequenceFlow id="Flow_NoAppr_Post" sourceRef="Script_NoApproval" targetRef="Gw_PostJoin" />
    <bpmn:sequenceFlow id="Flow_Agent_Done" sourceRef="Task_Agent" targetRef="Gw_AgentResult" />
    <bpmn:sequenceFlow id="Flow_Agent_Held" name="Hold" sourceRef="Gw_AgentResult" targetRef="End_Held">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=(vars.VarAgentErrorType != null &amp;&amp; vars.VarAgentErrorType != "") || vars.VarRecommendation == "HOLD_PO_MISMATCH"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Agent_Review" name="Review" sourceRef="Gw_AgentResult" targetRef="Gw_WaitJoin" />
    <bpmn:sequenceFlow id="Flow_Wait_Timer" sourceRef="Gw_WaitJoin" targetRef="Timer_Wait" />
    <bpmn:sequenceFlow id="Flow_Timer_Count" sourceRef="Timer_Wait" targetRef="Script_CountPoll" />
    <bpmn:sequenceFlow id="Flow_Count_Status" sourceRef="Script_CountPoll" targetRef="Task_Status" />
    <bpmn:sequenceFlow id="Flow_Status_Done" sourceRef="Task_Status" targetRef="Gw_Approved" />
    <bpmn:sequenceFlow id="Flow_Status_Error" name="Read error" sourceRef="Gw_Approved" targetRef="Gw_FailJoin">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=(vars.VarStatusErrorType != null &amp;&amp; vars.VarStatusErrorType != "") || vars.VarStatusFound == false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Approved" name="APPROVED" sourceRef="Gw_Approved" targetRef="Script_Approved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=vars.VarInvoiceLifecycleState == "APPROVED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Rejected" name="REJECTED" sourceRef="Gw_Approved" targetRef="End_Rejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=vars.VarInvoiceLifecycleState == "REJECTED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Loop" name="Still waiting, under 6 polls" sourceRef="Gw_Approved" targetRef="Gw_WaitJoin">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=(vars.VarInvoiceLifecycleState == "NEEDS_AP_REVIEW" || vars.VarInvoiceLifecycleState == "READY_FOR_APPROVAL") &amp;&amp; vars.VarPollCount &lt; 6</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PollCap" name="6 polls, no decision" sourceRef="Gw_Approved" targetRef="End_HeldNoDecision">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=(vars.VarInvoiceLifecycleState == "NEEDS_AP_REVIEW" || vars.VarInvoiceLifecycleState == "READY_FOR_APPROVAL") &amp;&amp; vars.VarPollCount &gt;= 6</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Appr_Unexpected" name="Other state" sourceRef="Gw_Approved" targetRef="Gw_FailJoin" />
    <bpmn:sequenceFlow id="Flow_Approved_Post" sourceRef="Script_Approved" targetRef="Gw_PostJoin" />
    <bpmn:sequenceFlow id="Flow_Join_Post" sourceRef="Gw_PostJoin" targetRef="Task_Post" />
    <bpmn:sequenceFlow id="Flow_Post_Done" sourceRef="Task_Post" targetRef="Gw_Posted" />
    <bpmn:sequenceFlow id="Flow_Posted_Yes" name="Yes" sourceRef="Gw_Posted" targetRef="End_Paid">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=vars.VarPosted == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Posted_No" name="No" sourceRef="Gw_Posted" targetRef="Gw_FailJoin" />
    <bpmn:sequenceFlow id="Flow_Err_Task_Intake" sourceRef="Err_Task_Intake" targetRef="Gw_FailJoin" />
    <bpmn:sequenceFlow id="Flow_Err_Task_POMatch" sourceRef="Err_Task_POMatch" targetRef="Gw_FailJoin" />
    <bpmn:sequenceFlow id="Flow_Err_Task_Agent" sourceRef="Err_Task_Agent" targetRef="Gw_FailJoin" />
    <bpmn:sequenceFlow id="Flow_Err_Task_Status" sourceRef="Err_Task_Status" targetRef="Gw_FailJoin" />
    <bpmn:sequenceFlow id="Flow_Err_Task_Post" sourceRef="Err_Task_Post" targetRef="Gw_FailJoin" />
    <bpmn:sequenceFlow id="Flow_Fail_End" sourceRef="Gw_FailJoin" targetRef="End_OpFailure" />
  </bpmn:process>
