# POMatch_Reference configuration. Copy to .env for local runs. Every value here is a name or a
# URL or local-only developer override. Hosted jobs should read the token from an Orchestrator asset.

# COMPLETE PO-lookup URL, used exactly as written. Default: http://localhost:8080/api/po-lookup
# For a cloud run, paste the whole signed URL from the bootcamp site (it ends in ?access_token=...).
# Nothing is appended to it and the token is shown as *** in logs and errors. Never commit a real one.
ERP_PO_LOOKUP_URL=http://localhost:8080/api/po-lookup
# Legacy alternative, used only when ERP_PO_LOOKUP_URL is unset: base URL + /api/po-lookup.
# ERP_API_URL=http://localhost:8080
ERP_TIMEOUT_SECONDS=10
# ERP_API_TOKEN=                     # local testing only; never commit a real token
# ERP_API_TOKEN_ASSET=MockERPAccessToken_Reference

# <user_name> suffix. Setting this alone renames every default below, e.g. BOOTCAMP_USER_NAME=Axel
# gives InvoiceQueue_Axel / APAutomation_Axel / AP_Invoice_Axel.
BOOTCAMP_USER_NAME=Reference

# Or override each name individually (these win over BOOTCAMP_USER_NAME).
# INVOICE_QUEUE_NAME=InvoiceQueue_Reference
# AP_FOLDER_PATH=APAutomation_Reference
# AP_INVOICE_ENTITY_NAME=AP_Invoice_Reference
# AP_INVOICE_ENTITY_ID=          # optional: skip the lookup by name (uip df entities list --native-only)
