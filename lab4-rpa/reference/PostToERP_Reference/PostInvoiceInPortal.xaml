    <If DisplayName="If the portal did not confirm" sap2010:WorkflowViewState.IdRef="If_1">
      <If.Condition>
        <InArgument x:TypeArguments="x:Boolean">[String.IsNullOrWhiteSpace(out_PostingId) OrElse Not out_PostingStatus.Trim().Equals("Submitted for payment", StringComparison.OrdinalIgnoreCase)]</InArgument>
      </If.Condition>
      <If.Then>
        <Sequence DisplayName="Then - fail the posting" sap2010:WorkflowViewState.IdRef="Sequence_3">
          <Throw DisplayName="Throw - portal did not confirm the submission" sap2010:WorkflowViewState.IdRef="Throw_1">
            <Throw.Exception>
              <InArgument x:TypeArguments="s:Exception">[New InvalidOperationException("The AP portal did not confirm the submission (posting id '" &amp; out_PostingId &amp; "', status '" &amp; out_PostingStatus &amp; "'). The record was not marked as posted.")]</InArgument>
            </Throw.Exception>
          </Throw>
        </Sequence>
      </If.Then>
    </If>
  </Sequence>
