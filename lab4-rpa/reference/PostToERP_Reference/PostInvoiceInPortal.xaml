          <Sequence DisplayName="Do" sap2010:WorkflowViewState.IdRef="Sequence_2">
            <TryCatch DisplayName="0 - Sign in if the portal asks (hosted portal only)" sap2010:WorkflowViewState.IdRef="TryCatch_1" sap2010:Annotation.AnnotationText="The hosted portal (commercial-bootcamp-mock-erp.onrender.com) shows a sign-in form and its /api calls return 401 without a session, so vendor Search would return nothing. The local portal (localhost:8080) has no sign-in, so these 5-second lookups time out and the Catch simply continues. The shared training login ap_user / passwod is synthetic and printed on the sign-in page; for anything beyond this lab, store credentials in an Orchestrator Credential asset and read them with Get Credential instead of hardcoding them.">
              <TryCatch.Try>
                <Sequence DisplayName="Try - sign in with the shared training account" sap2010:WorkflowViewState.IdRef="Sequence_4">
                  <uix:NTypeInto ActivateBefore="True" ClickBeforeMode="Single" DisplayName="0a - Type username into #input-portal-username" EmptyFieldMode="SingleLine" HealingAgentBehavior="SameAsCard" sap2010:WorkflowViewState.IdRef="NTypeInto_5" Text="ap_user" Timeout="5" Version="V5">
                    <uix:NTypeInto.Target>
                      <uix:TargetAnchorable ElementType="InputBox" FullSelectorArgument="&lt;webctrl id='input-portal-username' tag='INPUT' /&gt;" Guid="8a1f0d3e-6a1b-4c5f-9e21-0b1c2d3e4f13" ScopeSelectorArgument="&lt;html app='chrome.exe' title='Globex AP Portal*' /&gt;" SearchSteps="Selector" Version="V6" WaitForReadyArgument="Interactive" />
                    </uix:NTypeInto.Target>
                  </uix:NTypeInto>
                  <uix:NTypeInto ActivateBefore="True" ClickBeforeMode="Single" DisplayName="0b - Type training password into #input-portal-password" EmptyFieldMode="SingleLine" HealingAgentBehavior="SameAsCard" sap2010:WorkflowViewState.IdRef="NTypeInto_6" Text="passwod" Timeout="5" Version="V5">
                    <uix:NTypeInto.Target>
                      <uix:TargetAnchorable ElementType="InputBox" FullSelectorArgument="&lt;webctrl id='input-portal-password' tag='INPUT' /&gt;" Guid="8a1f0d3e-6a1b-4c5f-9e21-0b1c2d3e4f14" ScopeSelectorArgument="&lt;html app='chrome.exe' title='Globex AP Portal*' /&gt;" SearchSteps="Selector" Version="V6" WaitForReadyArgument="Interactive" />
                    </uix:NTypeInto.Target>
                  </uix:NTypeInto>
                  <uix:NClick ActivateBefore="True" ClickType="Single" DelayAfter="[in_StepDelaySeconds]" DisplayName="0c - Click 'Sign in to AP workspace' (#btn-sign-in)" HealingAgentBehavior="SameAsCard" KeyModifiers="None" MouseButton="Left" sap2010:WorkflowViewState.IdRef="NClick_7" Timeout="5" Version="V5">
                    <uix:NClick.Target>
                      <uix:TargetAnchorable ElementType="Button" FullSelectorArgument="&lt;webctrl id='btn-sign-in' tag='BUTTON' /&gt;" Guid="8a1f0d3e-6a1b-4c5f-9e21-0b1c2d3e4f15" ScopeSelectorArgument="&lt;html app='chrome.exe' title='Globex AP Portal*' /&gt;" SearchSteps="Selector" Version="V6" WaitForReadyArgument="Interactive" />
                    </uix:NClick.Target>
                  </uix:NClick>
                  <ui:LogMessage DisplayName="Log signed in" Level="Info" sap2010:WorkflowViewState.IdRef="LogMessage_3" Message="Portal sign-in form found; signed in with the shared training account" />
                </Sequence>
              </TryCatch.Try>
              <TryCatch.Catches>
                <Catch x:TypeArguments="s:Exception" sap2010:WorkflowViewState.IdRef="Catch_1">
                  <ActivityAction x:TypeArguments="s:Exception">
                    <ActivityAction.Argument>
                      <DelegateInArgument x:TypeArguments="s:Exception" Name="signInException" />
                    </ActivityAction.Argument>
                    <Sequence DisplayName="Catch - no sign-in form, continue" sap2010:WorkflowViewState.IdRef="Sequence_5">
                      <ui:LogMessage DisplayName="Log sign-in skipped" Level="Info" sap2010:WorkflowViewState.IdRef="LogMessage_4" Message="[&quot;No portal sign-in form within 5 s (local portal or existing session); continuing. &quot; &amp; signInException.GetType().Name]" />
                    </Sequence>
