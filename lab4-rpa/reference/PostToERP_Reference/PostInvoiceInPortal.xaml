            <uix:NGetText DisplayName="Read posting reference (#confirmation-id)" HealingAgentBehavior="SameAsCard" sap2010:WorkflowViewState.IdRef="NGetText_1" TextString="[out_PostingId]" Timeout="60" Version="V5">
              <uix:NGetText.Target>
                <uix:TargetAnchorable ElementType="Text" FullSelectorArgument="&lt;webctrl id='confirmation-id' tag='STRONG' /&gt;" Guid="8a1f0d3e-6a1b-4c5f-9e21-0b1c2d3e4f11" ScopeSelectorArgument="&lt;html app='chrome.exe' title='Globex AP Portal*' /&gt;" SearchSteps="Selector" Version="V6" WaitForReadyArgument="Interactive" />
              </uix:NGetText.Target>
