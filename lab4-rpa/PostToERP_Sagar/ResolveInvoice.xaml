                <Sequence DisplayName="Action" sap2010:WorkflowViewState.IdRef="Sequence_6">
                  <uda:QueryEntityRecords x:TypeArguments="local:AP_Invoice_Sagar" ContinueOnError="False" DisplayName="Query AP_Invoice_Sagar - sort by ProcessedTimestamp only (no designer filter)" EntityId="5c5aadee-d6bd-f111-a6a9-6045bddc9767" ExpansionDepth="2" sap2010:WorkflowViewState.IdRef="QueryEntityRecords_1" sap2010:Annotation.AnnotationText="No FilterArguments on purpose: the designer operators (Equals true, is null) compile but throw at runtime. Eligibility is applied with VB LINQ over the returned records." OutputRecords="[allRecords]" Skip="0" SortAscending="True" SortByField="[&quot;ProcessedTimestamp&quot;]" TimeoutInMs="60000" Top="1000" TotalRecords="[totalRecords]" />
