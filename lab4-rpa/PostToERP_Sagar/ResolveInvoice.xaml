            <Assign.Value>
              <InArgument x:TypeArguments="x:Int32">[allRecords.Where(Function(r) r.POMatched.GetValueOrDefault(False) AndAlso Not r.ApprovalNeeded.GetValueOrDefault(True) AndAlso Not r.PostedToERP.GetValueOrDefault(False)).Count()]</InArgument>
