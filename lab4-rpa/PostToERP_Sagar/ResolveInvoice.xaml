          <ui:RetryScope DisplayName="Retry Scope - Data Fabric query (transient faults)" NumberOfRetries="3" RetryInterval="00:00:05" sap2010:WorkflowViewState.IdRef="RetryScope_1" sap2010:Annotation.AnnotationText="Read-only query, safe to retry. One transient Data Fabric fault should not fault the whole job.">
            <ui:RetryScope.ActivityBody>
