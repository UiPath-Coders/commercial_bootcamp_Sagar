                    <udam:DynamicEntityField Id="2db834db-f7da-5b99-8347-192e588cc0f2" IsRequired="False" Name="InvoiceNumber"><udam:DynamicEntityField.ArgumentValue><InArgument x:TypeArguments="x:String">[in_InvoiceNumber]</InArgument></udam:DynamicEntityField.ArgumentValue></udam:DynamicEntityField>
                    <udam:DynamicEntityField Id="78fb95fd-8cf4-5a97-a345-b4b14685a8ca" IsRequired="False" Name="InvoiceDate"><udam:DynamicEntityField.ArgumentValue><InArgument x:TypeArguments="s:Nullable(s:DateTime)">[invoiceDateValue]</InArgument></udam:DynamicEntityField.ArgumentValue></udam:DynamicEntityField>
