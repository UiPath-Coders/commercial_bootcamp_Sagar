  <!--
    Main.xaml - Lab 2 reference (Commercial Bootcamp, Invoice-to-Pay / Office of the CFO).
    Two modes, one per-file workflow (ProcessInvoiceFile.xaml):
      * FileName blank  -> standalone batch: list InvoiceInbox_Reference and process every file one at a time; each newly
                           created valid record gets one InvoiceQueue_Reference item whose Reference is the record Id (Lab 3).
      * FileName given  -> single-invoice contract for Maestro (Lab 10): process exactly that file; add a queue item only
                           when CreateQueueItem is True and the record was newly created.
    Contract argument names (FileName, CreateQueueItem, RecordId, IsValid, WasDuplicate, ErrorMessage, ProcessedCount,
    CreatedCount, RejectedCount) intentionally do not follow the in_/out_ prefix rule. Local variables use n*/cfg*/item*
    names so that no variable shadows an argument (VB is case-insensitive).
    Resource settings live in the cfg* variables and use the _Reference suffix; participants' resources use
    _<user_name> (see README.md).
  -->
  <x:Members>
    <x:Property Name="FileName" Type="InArgument(x:String)" />
    <x:Property Name="CreateQueueItem" Type="InArgument(x:Boolean)" />
    <x:Property Name="RecordId" Type="OutArgument(x:String)" />
    <x:Property Name="IsValid" Type="OutArgument(x:Boolean)" />
    <x:Property Name="WasDuplicate" Type="OutArgument(x:Boolean)" />
    <x:Property Name="ErrorMessage" Type="OutArgument(x:String)" />
    <x:Property Name="ProcessedCount" Type="OutArgument(x:Int32)" />
    <x:Property Name="CreatedCount" Type="OutArgument(x:Int32)" />
    <x:Property Name="RejectedCount" Type="OutArgument(x:Int32)" />
  </x:Members>
  <TextExpression.NamespacesForImplementation>
    <sco:Collection x:TypeArguments="x:String">
      <x:String>System.Activities</x:String>
