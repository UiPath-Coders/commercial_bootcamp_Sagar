        </scg:Dictionary>
      </uasj:RunJob.Arguments>
    </uasj:RunJob>
    <!-- Validate before writing: PONumber present, TotalAmount present and numeric (thousands separators tolerated). -->
    <Assign x:TypeArguments="x:String" DisplayName="Assign amountClean">
      <Assign.To><OutArgument x:TypeArguments="x:String">[amountClean]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="x:String">[If(totalAmountText, String.Empty).Trim().Replace(",", String.Empty)]</InArgument></Assign.Value>
    </Assign>
    <Assign x:TypeArguments="x:String" DisplayName="Assign validationError">
      <Assign.To><OutArgument x:TypeArguments="x:String">[validationError]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="x:String">[String.Join("; ", New String() {If(String.IsNullOrWhiteSpace(poNumber), "PONumber is empty", Nothing), If(String.IsNullOrWhiteSpace(totalAmountText), "TotalAmount is empty", If(Regex.IsMatch(amountClean, "^-?[0-9]+(\.[0-9]+)?$"), Nothing, "TotalAmount is not numeric"))}.Where(Function(reason) reason IsNot Nothing))]</InArgument></Assign.Value>
    </Assign>
    <If DisplayName="If extraction is invalid">
      <If.Condition>
        <InArgument x:TypeArguments="x:Boolean">[Not String.IsNullOrEmpty(validationError)]</InArgument>
