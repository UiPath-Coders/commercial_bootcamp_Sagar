    <uasj:RunJob DisplayName="Run Job - Invoice_Extraction_Agent_Sagar" ProcessName="[in_AgentProcessName]" FolderPath="[in_AgentFolderPath]" ExecutionMode="Busy" FailWhenFaulted="True" TimeoutMS="[600000]" Job="[agentJob]">
      <uasj:RunJob.Arguments>
        <scg:Dictionary x:TypeArguments="x:String, Argument">
          <InArgument x:TypeArguments="upr:IResource" x:Key="SourceFile">[localFile]</InArgument>
          <OutArgument x:TypeArguments="x:String" x:Key="VendorName">[vendorName]</OutArgument>
