            <Assign.To><OutArgument x:TypeArguments="x:String">[out_RecordId]</OutArgument></Assign.To>
            <Assign.Value><InArgument x:TypeArguments="x:String">[recordId]</InArgument></Assign.Value>
          </Assign>
        </Sequence>
      </If.Else>
    </If>
  </Sequence>
</Activity>
