            </ui:LogMessage.Message>
          </ui:LogMessage>
        </Sequence>
      </If.Then>
      <If.Else>
        <Sequence DisplayName="Valid - lookup, insert, queue">
          <Assign x:TypeArguments="x:Boolean" DisplayName="Return out_IsValid = True">
            <Assign.To><OutArgument x:TypeArguments="x:Boolean">[out_IsValid]</OutArgument></Assign.To>
            <Assign.Value><InArgument x:TypeArguments="x:Boolean">[True]</InArgument></Assign.Value>
          </Assign>
          <Assign x:TypeArguments="x:Decimal" DisplayName="Parse totalAmount">
            <Assign.To><OutArgument x:TypeArguments="x:Decimal">[totalAmount]</OutArgument></Assign.To>
            <Assign.Value><InArgument x:TypeArguments="x:Decimal">[Decimal.Parse(amountClean, NumberStyles.Number, CultureInfo.InvariantCulture)]</InArgument></Assign.Value>
          </Assign>
          <Assign x:TypeArguments="s:Nullable(s:DateTime)" DisplayName="Parse optional invoice date">
            <Assign.To><OutArgument x:TypeArguments="s:Nullable(s:DateTime)">[invoiceDateValue]</OutArgument></Assign.To>
            <Assign.Value><InArgument x:TypeArguments="s:Nullable(s:DateTime)">[If(Regex.IsMatch(If(invoiceDateText, String.Empty).Trim(), "^([0-9]{1,2}/[0-9]{1,2}/[0-9]{4}|[0-9]{4}-[0-9]{2}-[0-9]{2})$"), CType(DateTime.ParseExact(invoiceDateText.Trim(), New String() {"M/d/yyyy", "yyyy-MM-dd"}, CultureInfo.InvariantCulture, DateTimeStyles.None), Nullable(Of DateTime)), CType(Nothing, Nullable(Of DateTime)))]</InArgument></Assign.Value>
          </Assign>
          <Assign x:TypeArguments="s:Nullable(s:DateTime)" DisplayName="Parse optional due date">
            <Assign.To><OutArgument x:TypeArguments="s:Nullable(s:DateTime)">[dueDateValue]</OutArgument></Assign.To>
            <Assign.Value><InArgument x:TypeArguments="s:Nullable(s:DateTime)">[If(Regex.IsMatch(If(dueDateText, String.Empty).Trim(), "^([0-9]{1,2}/[0-9]{1,2}/[0-9]{4}|[0-9]{4}-[0-9]{2}-[0-9]{2})$"), CType(DateTime.ParseExact(dueDateText.Trim(), New String() {"M/d/yyyy", "yyyy-MM-dd"}, CultureInfo.InvariantCulture, DateTimeStyles.None), Nullable(Of DateTime)), CType(Nothing, Nullable(Of DateTime)))]</InArgument></Assign.Value>
          </Assign>
          <uda:QueryEntityRecords x:TypeArguments="local:AP_Invoice_Sagar" ContinueOnError="False" DisplayName="Query AP_Invoice_Sagar by InvoiceNumber" EntityId="5c5aadee-d6bd-f111-a6a9-6045bddc9767" ExpansionDepth="2" OutputRecords="[existingRecords]" TotalRecords="[existingCount]" Skip="0" Top="1" TimeoutInMs="60000">
