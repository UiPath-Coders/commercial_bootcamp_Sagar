 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Main.xaml - Invoice_Intake_RPA_Sagar entry point.
      FileName blank  -> batch mode: list InvoiceInbox_Sagar, call ProcessInvoiceFile once per file, always queue new records.
      FileName given  -> single-file mode: process exactly that file, queue only when CreateQueueItem is True.
    Resource bindings (discovered in tenant Training):
      bucket InvoiceInbox_Sagar + queue InvoiceQueue_Sagar  in  Agentic Bootcamp/APAutomation_Sagar
      agent process Invoice_Extraction_Agent_Sagar          in  Agentic Bootcamp/APAutomation_Sagar/Invoice_Extraction_Agent_Sagar
      entity AP_Invoice_Sagar (tenant scope, 5c5aadee-d6bd-f111-a6a9-6045bddc9767)
  -->
  <x:Members>
    <x:Property Name="FileName" Type="InArgument(x:String)" />
    <x:Property Name="CreateQueueItem" Type="InArgument(x:Boolean)" />
    <x:Property Name="RecordId" Type="OutArgument(x:String)" />
    <x:Property Name="IsValid" Type="OutArgument(x:Boolean)" />
    <x:Property Name="WasDuplicate" Type="OutArgument(x:Boolean)" />
    <x:Property Name="ErrorMessage" Type="OutArgument(x:String)" />
    <x:Property Name="ProcessedCount" Type="OutArgument(x:Int32)" />
    <x:Property Name="CreatedCount" Type="OutArgument(x:Int32)" />
    <x:Property Name="RejectedCount" Type="OutArgument(x:Int32)" />
  </x:Members>
  <TextExpression.NamespacesForImplementation>
