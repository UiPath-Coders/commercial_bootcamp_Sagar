# Copy to .env and replace <user_name> with your signed-in first name.
# No credentials go here: `uip login` + the `uip codedagent` wrapper supply UIPATH_URL / UIPATH_ACCESS_TOKEN.

# Tenant-scoped Data Fabric entity the agent reads and writes (no folder key).
AP_INVOICE_ENTITY_NAME=AP_Invoice_<user_name>
# Optional: skip name resolution by giving the entity Id from `uip df entities list --native-only --output json`.
# AP_INVOICE_ENTITY_ID=

# LLM model reached through the UiPath LLM Gateway (see `uip codedagent list-models`).
AP_INVOICE_LLM_MODEL=gpt-4o-2024-11-20

# llm (default) or template. `template` never calls the gateway (deterministic narrative).
AP_INVOICE_NARRATIVE_MODE=llm

# Offline mode: point at a CSV/JSON fixture instead of Data Fabric, e.g.
# AP_INVOICE_FIXTURE_FILE=../../lab-assets/vendor-invoice/seeds/data-fabric-input.csv
# AP_INVOICE_FIXTURE_OUTPUT_DIR=fixture-output
