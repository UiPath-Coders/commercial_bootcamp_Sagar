{
  "version": "1.0",
  "id": "vendor-invoice-approval-smoke",
  "name": "Vendor Invoice Approval Smoke Tests",
  "description": "Deterministic gate paths for synthetic vendor invoices. Adapt the input key to the agent's actual entry-points.json before running.",
  "evaluatorRefs": ["JsonSimilarityEvaluator"],
  "evaluations": [
    {
      "id": "test-1-ap-train-1001",
      "name": "Complete evidence - ready for approval",
      "inputs": {
        "invoice_data": {
          "invoice_reference": "AP-TRAIN-1001",
          "po_matched": true,
          "approval_needed": true,
          "total_amount": 14850.0,
          "currency": "USD",
          "gl_account": "6120-Office Supplies",
          "cost_center": "CC-410 Facilities",
          "approver": "Jordan Example",
          "payment_terms": "Net 30",
          "vendor_risk_score": "Low",
          "receipt_reference": "GR-2026-0501-01",
          "invoice_line_summary": "Ergonomic chairs x25; standing desks x10"
        }
      },
      "evaluationCriterias": {
        "JsonSimilarityEvaluator": {
          "expectedOutput": {
            "invoice_reference": "AP-TRAIN-1001",
            "approval_evidence_state": "COMPLETE",
            "missing_approval_fields": [],
            "recommendation": "READY_FOR_APPROVAL",
            "invoice_lifecycle_state": "READY_FOR_APPROVAL"
          }
        }
      }
    },
    {
      "id": "test-2-ap-train-1002",
      "name": "Missing receipt reference - AP review required",
      "inputs": {
        "invoice_data": {
          "invoice_reference": "AP-TRAIN-1002",
          "po_matched": true,
          "approval_needed": true,
          "total_amount": 23400.0,
          "currency": "USD",
          "gl_account": "5210-Freight",
          "cost_center": "CC-220 Supply Chain",
          "approver": "Casey Fixture",
          "payment_terms": "Net 45",
          "vendor_risk_score": "Medium",
          "receipt_reference": null,
          "invoice_line_summary": "Inbound freight March; fuel surcharge"
        }
      },
      "evaluationCriterias": {
        "JsonSimilarityEvaluator": {
          "expectedOutput": {
            "invoice_reference": "AP-TRAIN-1002",
            "approval_evidence_state": "INCOMPLETE",
            "missing_approval_fields": ["ReceiptReference"],
            "recommendation": "NEEDS_AP_REVIEW",
            "invoice_lifecycle_state": "NEEDS_AP_REVIEW"
          }
        }
      }
    },
    {
      "id": "test-3-ap-train-1003",
      "name": "Under threshold and matched - auto-approved",
      "inputs": {
        "invoice_data": {
          "invoice_reference": "AP-TRAIN-1003",
          "po_matched": true,
          "approval_needed": false,
          "total_amount": 7980.0,
          "currency": "USD",
          "gl_account": "6410-Cloud Hosting",
          "cost_center": "CC-310 IT",
          "approver": "Riley Sample",
          "payment_terms": "Net 30",
          "vendor_risk_score": "Low",
          "receipt_reference": "GR-2026-0503-03",
          "invoice_line_summary": "Compute reservation Q1; object storage"
        }
      },
      "evaluationCriterias": {
        "JsonSimilarityEvaluator": {
          "expectedOutput": {
            "invoice_reference": "AP-TRAIN-1003",
            "approval_evidence_state": "NOT_REQUIRED",
            "missing_approval_fields": [],
            "recommendation": "AUTO_APPROVED",
            "invoice_lifecycle_state": "AUTO_APPROVED"
          }
        }
      }
    },
    {
      "id": "test-4-ap-train-1004",
      "name": "PO mismatch - hold",
      "inputs": {
        "invoice_data": {
          "invoice_reference": "AP-TRAIN-1004",
          "po_matched": false,
          "approval_needed": true,
          "total_amount": 31200.0,
          "currency": "USD",
          "gl_account": "5110-Raw Materials",
          "cost_center": "CC-110 Production",
          "approver": "Morgan Demo",
          "payment_terms": "Net 30",
          "vendor_risk_score": "Medium",
          "receipt_reference": "GR-2026-0504-02",
          "invoice_line_summary": "Steel coil 12t; cutting service"
        }
      },
      "evaluationCriterias": {
        "JsonSimilarityEvaluator": {
          "expectedOutput": {
            "invoice_reference": "AP-TRAIN-1004",
            "approval_evidence_state": "NOT_EVALUATED",
            "missing_approval_fields": [],
            "recommendation": "HOLD_PO_MISMATCH",
            "invoice_lifecycle_state": "HOLD_PO_MISMATCH"
          }
        }
      }
    },
    {
      "id": "test-5-ap-train-1005",
      "name": "Missing GL account and approver - AP review required",
      "inputs": {
        "invoice_data": {
          "invoice_reference": "AP-TRAIN-1005",
