          "expectedOutput": {
            "invoice_reference": "AP-TRAIN-1005",
            "approval_evidence_state": "INCOMPLETE",
            "missing_approval_fields": ["GLAccount", "Approver"],
            "recommendation": "NEEDS_AP_REVIEW",
            "invoice_lifecycle_state": "NEEDS_AP_REVIEW"
          }
        }
      }
    },
    {
      "id": "test-6-ap-train-1006",
      "name": "Complete evidence - second ready-for-approval case",
      "inputs": {
        "invoice_data": {
